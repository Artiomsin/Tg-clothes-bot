{
  "name": "tg-clothes-bot",
  "version": "1.0.0",
  "description": "Telegram bot for clothing orders using grammY and Drizzle ORM",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "drizzle-kit push",
    "test": "vitest"
  },
  "keywords": [
    "telegram",
    "bot",
    "grammy",
    "drizzle",
    "typescript",
    "postgresql",
    "nestjs"
  ],
  "author": "Artiom",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "grammy": "^1.38.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/node": "^24.6.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
